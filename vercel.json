{
  "functions": {
    "api/scanner-v16-recognize.js": {"maxDuration": 90},
    "api/scanner-v16-gemini.js": {
      "maxDuration": 60
    },
    "api/scanner-v16-ximilar.js": {
      "maxDuration": 60
    },
    "api/scanner-v16-openai.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/u/:username",
      "destination": "/u.html?username=:username"
    },
    {
      "source": "/listing/:id",
      "destination": "/api/compliance-message-dispatch?public_listing=:id"
    },
    {
      "source": "/api/tracking/register",
      "destination": "/api/compliance-message-dispatch?tracking_register=1"
    },
    {
      "source": "/api/tracking/aftership",
      "destination": "/api/compliance-message-dispatch?aftership_webhook=1"
    }
  ]
}
