          "name": "market_seller_stats",
          "schema": "public",
          "definition": " SELECT seller_id,\n    (count(*) FILTER (WHERE (status = 'active'::text)))::integer AS active_listings,\n    (count(*) FILTER (WHERE (status = 'sold'::text)))::integer AS completed_sales,\n    (COALESCE(sum(deal_price) FILTER (WHERE (status = 'sold'::text)), (0)::numeric))::numeric(12,2) AS completed_volume\n   FROM market_listings\n  GROUP BY seller_id;"
